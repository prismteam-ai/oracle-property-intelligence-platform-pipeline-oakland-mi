# Safe local examples only. Do not put credentials, review codes or map keys here.
PRISM_DEPLOY_REGION=us-east-2
# Default is real; supply the absolute accepted public-safe artifact path privately.
# PRISM_SNAPSHOT_DIR=/absolute/path/to/public-safe
# Explicit separate synthetic demo:
# PRISM_DATA_MODE=synthetic
# PRISM_ACCESS_MODE=local
# Protected companion paths are refused with local access.
# Live account/role/source/archive/cost pins belong in the approved private operator environment.

# Default remains reserved2. The approved shared account route requires fresh private proof:
# PRISM_CONCURRENCY_MODE=existing-account-shared
# PRISM_SHARED_ACCOUNT_CONCURRENCY_APPROVED=yes
# PRISM_EXISTING_ACCOUNT_CONCURRENCY=10
# PRISM_ACCOUNT_CONCURRENCY_PROOF=/private/owner0600/metadata.json
# PRISM_SHARED_ACCOUNT_OPERATION_LIMIT=40

# Review deployment requires private PRISM_EXPECTED_OPERATOR_ROLE_ARN for the exact
# prism-assessment-review-deployer assumed role; root/direct IAM users are refused.
# Standard bootstrap qualifier prismrvw; toolkit stack PrismAssessmentReviewToolkit.
