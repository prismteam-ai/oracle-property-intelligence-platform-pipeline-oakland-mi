{
  "name": "@prism/oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "api": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "turbo run build",
    "test:browser": "playwright test",
    "cdk:synth": "tsx infra/cdk/app.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "maplibre-gl": "6.16.0",
    "zod": "4.6.7",
    "@duckdb/node-api": "2.0.0-r.1",
    "ai": "7.0.154",
    "@ai-sdk/provider": "4.0.34"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "aws-cdk": "2.1146.1",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.1",
    "prettier": "3.9.10",
    "@eslint/js": "10.0.1"
  }
