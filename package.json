{
  "name": "@prism/oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "api": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "turbo run build",
    "test:browser": "playwright test",
    "cdk:synth": "tsx infra/cdk/app.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "package:lambda": "tsx scripts/package-lambda.ts",
    "runtime:emulate": "tsx scripts/emulate-lambda.ts",
    "deploy": "tsx scripts/cloud.ts deploy",
    "smoke": "tsx scripts/cloud.ts smoke",
    "evidence": "tsx scripts/cloud.ts evidence",
    "rotate-access": "tsx scripts/cloud.ts rotate-access",
    "destroy": "tsx scripts/cloud.ts destroy",
    "snapshot:build": "tsx scripts/build-county.ts",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "publication:local": "tsx scripts/publication-local.ts",
    "benchmark:real": "tsx scripts/benchmark-real.ts",
    "cdk:check": "tsx scripts/check-cloud-plan.ts",
    "snapshot:run": "tsx scripts/build-county-run.ts",
    "publication:restore": "tsx scripts/restore-publication.ts",
    "ci:verify": "tsx scripts/ci-verify.ts",
    "contract:check": "tsx scripts/check-quality.ts contract",
    "scan:source": "tsx scripts/check-quality.ts source",
    "docs:check": "tsx scripts/check-quality.ts docs",
    "workflow:check": "tsx scripts/check-workflow.ts",
    "tooling:install": "tsx scripts/install-tooling.ts",
    "audit:production": "pnpm audit --prod --audit-level high",
    "runtime:alert:emulate": "tsx scripts/emulate-alert.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-lambda-powertools/metrics": "2.36.0",
    "@aws-lambda-powertools/tracer": "2.36.0",
    "@aws-sdk/client-dynamodb": "3.1157.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/client-secrets-manager": "3.1157.0",
    "@aws-sdk/lib-dynamodb": "3.1157.0",
    "@duckdb/node-api": "2.0.0-r.1",
    "@ipld/car": "5.4.7",
    "@ipld/dag-cbor": "10.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "blockstore-core": "7.0.1",
    "ipfs-unixfs-exporter": "16.2.3",
    "ipfs-unixfs-importer": "17.1.1",
    "maplibre-gl": "6.16.0",
    "multiformats": "14.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.0"
