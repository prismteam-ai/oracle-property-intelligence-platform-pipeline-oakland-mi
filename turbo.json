{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {}
  },
  "globalDependencies": [
    "packages/**/src/**",
    "vite.config.ts",
    "tsconfig.json"
  ]
}
